# Copy to .env, then fill a dedicated project database connection locally.
# Empty by default: no connection to your existing postgres database is assumed.
DDA_DATABASE_URL=
# Default data directory is <project>/.local/data. Set an absolute path to override.
DDA_DATA_DIR=
DDA_MAX_UPLOAD_MB=100
DDA_PORT=8765
DDA_PDF_PYTHON=
DDA_OCR_PYTHON=
DDA_OCR_MODELS_DIR=
DDA_RETRIEVAL_PYTHON=
DDA_EMBEDDING_DIR=
DDA_RERANKER_DIR=
DDA_VISION_PYTHON=
DDA_VISION_MODELS_DIR=
DDA_VISION_TIMEOUT_SECONDS=300
DDA_PDF_RENDER_SCALE=2
DDA_VISION_REGIONS_PER_PAGE=3
# Local performance summaries contain counts/timings only. Set 0 to disable collection.
DDA_PERFORMANCE_ENABLED=1
# Per app scope: ordinary pooled connections (plus one independent queue lease).
DDA_DB_POOL_SIZE=4
DDA_DB_POOL_TIMEOUT=3
DDA_DB_POOL_MAX_WAITING=8
# Durable stages: native extraction may overlap downstream; heavy inference is serialized.
DDA_STAGE_WINDOW_PAGES=10
DDA_STAGE_BACKLOG_PAGES=40
DDA_STAGE_FLUSH_SECONDS=3
# on（默认）为每份材料建立父子索引。shadow 只处理下面列出的最多 20 份；off 只用页级切片。
DDA_PARENT_INDEX_MODE=on
DDA_PARENT_INDEX_DOCUMENT_IDS=
# Query mode mixed (default) or page. Empty IDs auto-discover up to 20 closed candidates per project.
# Optional explicit UUID list (max 20) narrows selection. Only complete current parent indexes are used.
DDA_SEARCH_INDEX_MODE=mixed
DDA_SEARCH_PARENT_DOCUMENT_IDS=
# One resident heavy model per app process; 0 falls back to legacy one-shot workers.
DDA_MODEL_RUNTIME_ENABLED=1
DDA_MODEL_IDLE_SECONDS=30
DDA_MODEL_LOAD_TIMEOUT=300
# Background/direct admission wait; interactive search uses its remaining total budget.
DDA_MODEL_QUEUE_TIMEOUT=3
DDA_MODEL_MAX_WAITING=8
DDA_MODEL_CPU_THREADS=4
# Cooperative search budget; cold fingerprint/DB work retain their own bounds.
DDA_SEARCH_TIMEOUT_SECONDS=120
# Recall: hybrid (default), vector, or keyword. Fusion rrf or weighted, applied before rerank.
# Per-channel limits are 1-50. The fused list sent to the reranker stays 1-12.
DDA_RETRIEVAL_MODE=hybrid
DDA_RETRIEVAL_FUSION=rrf
DDA_RETRIEVAL_VECTOR_LIMIT=12
DDA_RETRIEVAL_KEYWORD_LIMIT=12
DDA_RETRIEVAL_CANDIDATE_LIMIT=12
DDA_RETRIEVAL_RRF_K=60
DDA_RETRIEVAL_VECTOR_WEIGHT=1
DDA_RETRIEVAL_KEYWORD_WEIGHT=1
# Read-only MCP for a remote client. Required before `python -m dd_agent mcp`.
# Default bind is loopback; set DDA_MCP_HOST=0.0.0.0 to accept LAN clients.
# Streamable HTTP: http://127.0.0.1:8766/mcp . /sse is the legacy 2024-11-05 transport.
# Send the same key on every request: Authorization: Bearer <key>
DDA_MCP_API_KEY=
DDA_MCP_HOST=127.0.0.1
DDA_MCP_PORT=8766
# Legacy .doc/.xls/.ppt are converted on this machine with LibreOffice, then parsed as docx/xlsx/pptx.
# Empty: on Windows, look in the default LibreOffice install. A missing soffice marks that file unsupported.
# The original is never modified. Conversion uses a private profile, disables macros, and is not retried.
DDA_SOFFICE_PATH=
DDA_SOFFICE_TIMEOUT_SECONDS=120
# How many soffice conversions may run at once (1-4).
DDA_SOFFICE_CONCURRENCY=1
